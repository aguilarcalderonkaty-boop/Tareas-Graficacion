import numpy as np
import cv2 as cv

# Imagen blanca
img = np.ones((500, 500, 3), dtype=np.uint8) * 255

# Centro del corazón
cx, cy = 250, 250

# Colores
rojo_base = (0, 0, 255)        # rojo intenso
rojo_brillo = (100, 50, 255)   # tono más claro para brillo
rojo_sombra = (0, 0, 180)      # tono más oscuro para sombra

# Dibujar corazón con ecuación de google
for i in range(-150, 151):
    for j in range(-150, 151):
        x = i / 100.0
        y = j / 100.0
        # Ecuación del corazón
        if (x**2 + y**2 - 1)**3 - x**2 * (y**3) <= 0:
            # Posición en la imagen
            px, py = cx + i, cy - j
            if 0 <= px < 500 and 0 <= py < 500:
                # Brillo en la parte superior izquierda
                if i < 0 and j > 30:
                    img[py, px] = rojo_brillo
                # Sombra en la parte inferior derecha
                elif i > 0 and j < -30:
                    img[py, px] = rojo_sombra
                else:
                    img[py, px] = rojo_base

# Mostrar imagen
cv.imshow("Corazón pixel art", img)
cv.waitKey(0)
cv.destroyAllWindows()
