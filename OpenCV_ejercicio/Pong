import cv2 as cv
import numpy as np
import random

# Generar lienzo
canvas = np.full((500, 500, 3), 255, dtype=np.uint8)

# Posiciones bola móvil
dx, dy = 0, 0
# Velocidades iniciales
vx, vy = 2, 3

# Coordenadas de  bola fija
fixed_x, fixed_y = 250, 250

while True:
    # Reiniciar fondo 
    canvas[:] = 255

    # Dibujar bola móvil
    cv.circle(canvas, (30 + dx, 30 + dy), 30, (0, 0, 255), -1)

    # Dibujar bola fija
    cv.circle(canvas, (fixed_x, fixed_y), 30, (255, 0, 0), -1)

    # Actualizar posición
    dx += vx
    dy += vy

    # Calcular distancia entre centros
    distancia = np.hypot(fixed_x - (30 + dx), fixed_y - (30 + dy))

    # Rebote si colisionan
    if distancia <= 60:
        vx = -vx
        vy = -vy

    # Rebotes contra los bordes
    if (30 + dx) + 20 >= canvas.shape[1]:   # borde derecho
        vx = -random.randint(1, 6)
    if (30 + dx) - 20 <= 0:                 # borde izquierdo
        vx = random.randint(1, 6)
    if (30 + dy) + 20 >= canvas.shape[0]:   # borde inferior
        vy = -random.randint(1, 6)
    if (30 + dy) - 20 <= 0:                 # borde superior
        vy = random.randint(1, 6)

    # Mostrar ventana
    cv.imshow("Pelota rebotando", canvas)
    cv.waitKey(10)

    # Condición de salida: cerrar ventana
    if cv.getWindowProperty("Pelota rebotando", cv.WND_PROP_VISIBLE) < 1:
        break

cv.destroyAllWindows()
